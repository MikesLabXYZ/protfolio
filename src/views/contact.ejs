<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/nav') %>
<main>
  <div class="container">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch</h1>
    <div class="page-body">
      <ul class="contact-list">
        <% if (seo.person.email) { %><li class="reveal delay-0"><span class="k">email</span> <a href="mailto:<%= seo.person.email %>"><%= seo.person.email %></a></li>
        <% } %><li class="reveal delay-1"><span class="k">linkedin</span> <a href="<%= seo.person.linkedin %>"><%= seo.person.linkedin.replace(/^https?:\/\//, '') %></a></li>
        <% if (seo.person.github) { %><li class="reveal delay-2"><span class="k">github</span> <a href="<%= seo.person.github %>"><%= seo.person.github.replace(/^https?:\/\//, '') %></a></li>
        <% } %>      </ul>
    </div>
  </div>
</main>
<%- include('partials/footer') %>
<script src="/static/js/reveal.js"></script>
</body>
</html>
