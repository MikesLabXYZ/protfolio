<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="footer-name">Michael Dagan</span>
        <p>Cloud infrastructure, security, and the technical operations that hold it together.</p>
      </div>

      <div class="footer-col">
        <span class="footer-heading">Site</span>
        <a href="/about">About</a>
        <a href="/experience">Experience</a>
        <a href="/projects">Projects</a>
        <a href="/contact">Contact</a>
      </div>

      <div class="footer-col">
        <span class="footer-heading">Contact</span>
        <a href="<%= seo.person.linkedin %>">LinkedIn</a>
        <% if (seo.person.github) { %><a href="<%= seo.person.github %>">GitHub</a>
        <% } %><% if (seo.person.email) { %><a href="mailto:<%= seo.person.email %>">Email</a>
        <% } %>      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; <%= new Date().getFullYear() %> Michael Dagan</span>
    </div>
  </div>
</footer>
