# Copy this file to .env for local/docker-compose use. All values below are
# placeholders - see ARCHITECTURE.md for what each becomes on AWS.
#
# Nothing in this file is required to run the app locally beyond the core
# DB_* block and PORT. Every AWS-specific variable below is optional and
# gated in code: leaving it unset disables the corresponding AWS SDK call
# entirely rather than failing, so `docker compose up` works with none of
# them set and nothing in AWS reachable.

PORT=3000
NODE_ENV=development

# --- Core database connection -----------------------------------------
# Always required. Host/port/database name are read from here even when
# DB_SECRET_ARN is set below (only username/password come from the secret
# in that case).
DB_HOST=db
DB_PORT=5432
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=changeme

# --- AWS Secrets Manager (optional) -------------------------------------
# If set, username/password are fetched from this secret at startup instead
# of DB_USER/DB_PASSWORD above, and re-fetched automatically if the DB
# rejects a query with "invalid_password" (i.e. after Secrets Manager
# rotates the credential) - no redeploy needed. Leave unset for local
# testing; the app never touches the AWS SDK when this is unset.
# DB_SECRET_ARN=arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:NAME

# --- Read replica (optional) --------------------------------------------
# If set, read-only routes (project list/detail) query this host instead of
# DB_HOST. Writes and migrations always use DB_HOST. Leave unset to point
# both at the primary.
# DB_HOST_RO=

# --- In-container TLS (optional, ECS only) -------------------------------
# Both must be set together to start the app over HTTPS instead of HTTP.
# The Docker image bakes a self-signed cert at build time, but these two
# variables are NOT set as image defaults - only in the ECS task
# definition. The load balancer terminates the public-facing certificate;
# this one only covers the LB-to-task hop.
# TLS_CERT_PATH=/app/certs/tls.crt
# TLS_KEY_PATH=/app/certs/tls.key

# --- Public base URL (optional) ------------------------------------------
# Used as the origin for canonical/Open Graph tags and any absolute
# redirects. Needed because CloudFront sits in front of the app, so the
# Host header the app sees isn't necessarily the public hostname. Leave
# unset locally - it falls back to deriving the origin from the request.
# PUBLIC_BASE_URL=https://example.com

# --- Uploaded assets ------------------------------------------------------
# Where project images (and other served uploads) are read from/written to.
# In docker-compose this is a named volume; on AWS it's an EFS mount point.
UPLOAD_PATH=/app/uploads

# --- Admin image upload (optional) ---------------------------------------
# Shared-secret bearer token for POST /admin/projects/:slug/image. If unset,
# that route is not registered at all - not just unauthenticated, absent.
# ADMIN_UPLOAD_TOKEN=
