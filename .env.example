# Copy this file to .env for local/docker-compose use.
# On AWS, these are populated at container start from Secrets Manager instead
# of living in a file - see README.md "AWS deployment notes".

PORT=3000
NODE_ENV=development

DB_HOST=db
DB_PORT=5432
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=changeme

# Local filesystem path for uploaded/served assets (resume, project images).
# On AWS this path is an EFS mount point on the EC2 instance.
# In docker-compose this is a named volume.
UPLOAD_DIR=/app/uploads
